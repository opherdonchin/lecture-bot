# Example instance environment for the Statistics course.
# Copy to /srv/lecture-bot/instances/statistics/instance.env (group appops, mode 0640)
# and fill in the <...> values. Never commit the filled-in file.
#
# Set EVERY setting here, with absolute paths inside this instance's folder.
# The code checkout must have no .env; a setting omitted here would otherwise
# fall back to a default inside the shared checkout.

APP_NAME=lecture-bot-statistics
APP_ENV=prod

OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_MODEL=gpt-5.4

DATABASE_URL=sqlite:////srv/lecture-bot/instances/statistics/data/lecture_bot.db
LECTURES_DIR=/srv/lecture-bot/instances/statistics/lectures

ADMIN_USERNAME=stats-admin
ADMIN_PASSWORD=<STATISTICS_ADMIN_PASSWORD>

LECTURE_BOT_STUDENT_ROOT_PATH=/stats
LECTURE_BOT_ADMIN_ROOT_PATH=/stats-admin
LECTURE_BOT_STUDENT_HOST=127.0.0.1
LECTURE_BOT_STUDENT_PORT=8000
LECTURE_BOT_ADMIN_HOST=127.0.0.1
LECTURE_BOT_ADMIN_PORT=8001

# The admin app's "Restart Student App" button runs this command.
STUDENT_RESTART_COMMAND=sudo -n /usr/bin/systemctl restart lecture-bot@statistics.service

MOODLE_SUBMISSIONS_DIR=/srv/lecture-bot/instances/statistics/data/submissions
MOODLE_PARTICIPANTS_CSV=/srv/lecture-bot/instances/statistics/data/submissions/courseid_64733_participants.csv
MOODLE_DEADLINES_CSV=/srv/lecture-bot/instances/statistics/data/submissions/moodle_deadlines.csv
MOODLE_DEADLINE_TIMEZONE_OFFSET=+03:00
MOODLE_GRADE_IMPORT_CSV=/srv/lecture-bot/instances/statistics/data/submissions/moodle_grade_import.csv
MOODLE_GRADE_IMPORT_REPORT_CSV=/srv/lecture-bot/instances/statistics/data/submissions/moodle_grade_import_report.csv

TUTOR_PROMPT_TEMPLATE=tutor_prompt.md
SESSION_TIMEOUT_MINUTES=30
SESSION_WARNING_MINUTES=5
RECENT_MESSAGE_LIMIT=10
MAX_DIALOGUE_CONTEXT_CHARS=45000
MAX_GRADING_CONTEXT_CHARS=70000
SAMPLED_TOPIC_COUNT=7
OPENING_TOPIC_CHOICE_COUNT=3
