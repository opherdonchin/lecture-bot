# Example instance environment for the PML course.
# Values containing spaces are quoted, so that both systemd and the shell's
# `source` (used in the runbook) read them correctly.
# Copy to /srv/lecture-bot/instances/pml/instance.env (group appops, mode 0640)
# and fill in the <...> values. Never commit the filled-in file.
#
# Set EVERY setting here, with absolute paths inside this instance's folder.
# The code checkout must have no .env; a setting omitted here would otherwise
# fall back to a default inside the shared checkout.

APP_NAME=lecture-bot-pml
APP_ENV=prod

OPENAI_API_KEY="<OPENAI_API_KEY>"
OPENAI_MODEL=gpt-5.4

DATABASE_URL=sqlite:////srv/lecture-bot/instances/pml/data/lecture_bot.db
LECTURES_DIR=/srv/lecture-bot/instances/pml/lectures

ADMIN_USERNAME=pml-admin
ADMIN_PASSWORD="<PML_ADMIN_PASSWORD>"

LECTURE_BOT_STUDENT_ROOT_PATH=/pml
LECTURE_BOT_ADMIN_ROOT_PATH=/pml-admin
LECTURE_BOT_STUDENT_HOST=127.0.0.1
LECTURE_BOT_STUDENT_PORT=8002
LECTURE_BOT_ADMIN_HOST=127.0.0.1
LECTURE_BOT_ADMIN_PORT=8003

# The admin app's "Restart Student App" button runs this command.
STUDENT_RESTART_COMMAND="sudo -n /usr/bin/systemctl restart lecture-bot@pml.service"

MOODLE_SUBMISSIONS_DIR=/srv/lecture-bot/instances/pml/data/submissions
MOODLE_PARTICIPANTS_CSV="/srv/lecture-bot/instances/pml/data/submissions/courseid_<PML_MOODLE_COURSE_ID>_participants.csv"
MOODLE_DEADLINES_CSV=/srv/lecture-bot/instances/pml/data/submissions/moodle_deadlines.csv
MOODLE_DEADLINE_TIMEZONE_OFFSET=+03:00
MOODLE_GRADE_IMPORT_CSV=/srv/lecture-bot/instances/pml/data/submissions/moodle_grade_import.csv
MOODLE_GRADE_IMPORT_REPORT_CSV=/srv/lecture-bot/instances/pml/data/submissions/moodle_grade_import_report.csv

# Chat language: "english" or "any". Students and the tutor may write in any language; final reports stay English.
CHAT_LANGUAGE=any
TUTOR_PROMPT_TEMPLATE=pml_tutor_prompt.md
SESSION_TIMEOUT_MINUTES=30
SESSION_WARNING_MINUTES=5
RECENT_MESSAGE_LIMIT=10
MAX_DIALOGUE_CONTEXT_CHARS=45000
MAX_GRADING_CONTEXT_CHARS=70000
SAMPLED_TOPIC_COUNT=7
OPENING_TOPIC_CHOICE_COUNT=3
