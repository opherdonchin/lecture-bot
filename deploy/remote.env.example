# Copy to deploy/remote.env on a development machine.
# This file is intentionally local-only and should not be committed.

LECTURE_BOT_REMOTE_HOST=example.edu
LECTURE_BOT_REMOTE_USER=lecture-bot
LECTURE_BOT_REMOTE_ROOT=/srv/lecture-bot
# Pixi binary of the SSH user (non-interactive SSH may not have it on PATH).
LECTURE_BOT_REMOTE_PIXI_BIN=/home/lecture-bot/.pixi/bin/pixi
LECTURE_BOT_REMOTE_LOG_DIR=/var/log/lecture-bot

# Legacy Statistics services (until Statistics moves to the template units).
LECTURE_BOT_REMOTE_STUDENT_SERVICE=lecture-bot
LECTURE_BOT_REMOTE_ADMIN_SERVICE=lecture-bot-admin

# Course instances running from the lecture-bot@<instance> template units,
# as <instance>=<public path> pairs.
LECTURE_BOT_REMOTE_INSTANCES="pml=/pml"

# Optional extra ssh flags, split on spaces.
LECTURE_BOT_REMOTE_SSH_OPTS=
