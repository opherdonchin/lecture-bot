# Example/template only. Copy to /etc/systemd/system/lecture-bot-admin@.service.
# One unit per course instance: lecture-bot-admin@pml.service reads
# /srv/lecture-bot/instances/pml/instance.env and logs to
# /var/log/lecture-bot/pml-admin.log. All instances share the code checkout.
[Unit]
Description=Lecture Bot admin app (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lecturebot
Group=appops
WorkingDirectory=/srv/lecture-bot/code
Environment=PATH=/home/lecturebot/.pixi/bin:/usr/local/bin:/usr/bin:/bin
# Do not write bytecode caches into the shared, deployer-owned Pixi environment.
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/srv/lecture-bot/instances/%i/instance.env
ExecStart=/home/lecturebot/.pixi/bin/pixi run --as-is admin-serve
Restart=on-failure
RestartSec=5
UMask=0007
LogsDirectory=lecture-bot
LogsDirectoryMode=02775
StandardOutput=append:/var/log/lecture-bot/%i-admin.log
StandardError=append:/var/log/lecture-bot/%i-admin.log

[Install]
WantedBy=multi-user.target
