{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "latest_turn_assessment",
    "state_update_audit",
    "next_move",
    "self_verification"
  ],
  "properties": {
    "latest_turn_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "student_message_role",
        "engaged_topic_ids",
        "evidence_summary",
        "evidence_status",
        "evidence_dimensions",
        "assistance_context",
        "challenge_level_observed"
      ],
      "properties": {
        "student_message_role": {
          "type": "string",
          "enum": [
            "content_answer",
            "content_question",
            "procedural_request",
            "meta_or_gaming_request",
            "off_task",
            "ambiguous_or_uninterpretable"
          ]
        },
        "engaged_topic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_summary": {
          "type": "string",
          "maxLength": 500
        },
        "evidence_status": {
          "type": "string",
          "enum": [
            "none",
            "independent",
            "assisted_progress",
            "assisted_repetition",
            "generic_or_fluent_untested",
            "copied_or_repeated",
            "procedural_only",
            "ambiguous",
            "off_task"
          ]
        },
        "evidence_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "criterion",
              "distinction",
              "explanation_why",
              "application_transfer",
              "practical_interpretation",
              "independent_correction_ownership",
              "synthesis"
            ]
          },
          "uniqueItems": true
        },
        "assistance_context": {
          "type": "string",
          "enum": [
            "independent",
            "after_small_hint",
            "after_substantial_scaffold",
            "after_correction",
            "not_applicable",
            "unclear"
          ]
        },
        "challenge_level_observed": {
          "type": "string",
          "enum": [
            "normal",
            "elevated",
            "high",
            "not_applicable"
          ]
        }
      }
    },
    "state_update_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mastery_update_performed",
        "topic_updates",
        "no_update_reason",
        "over_update_risk_checked"
      ],
      "properties": {
        "mastery_update_performed": {
          "type": "boolean"
        },
        "topic_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic_id",
              "mastery_update_kind",
              "mastery_after_update",
              "evidence_note_basis",
              "assisted_cap_applied"
            ],
            "properties": {
              "topic_id": {
                "type": "string",
                "minLength": 1
              },
              "mastery_update_kind": {
                "type": "string",
                "enum": [
                  "no_update",
                  "new_or_revised_mastery",
                  "evidence_note_only",
                  "current_topic_only"
                ]
              },
              "mastery_after_update": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "evidence_note_basis": {
                "type": "string",
                "maxLength": 300
              },
              "assisted_cap_applied": {
                "type": "boolean"
              }
            }
          }
        },
        "no_update_reason": {
          "type": "string",
          "enum": [
            "none",
            "no_content_evidence",
            "procedural_only",
            "copied_or_repeated",
            "ambiguous_or_uninterpretable",
            "off_task_or_redirect",
            "unsupported_topic_id",
            "timing_or_lifecycle_handoff",
            "other"
          ]
        },
        "over_update_risk_checked": {
          "type": "boolean"
        }
      }
    },
    "next_move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction_mode",
        "topic_action",
        "challenge_level",
        "materiality_of_next_question",
        "answer_feedback_cycle_feasible",
        "student_agency_signal",
        "rationale"
      ],
      "properties": {
        "interaction_mode": {
          "type": "string",
          "enum": [
            "basic_conceptual_probe",
            "evidence_interpretation_and_feedback",
            "scaffolded_support",
            "adaptive_challenge",
            "breadth_transition",
            "procedural_support",
            "interaction_repair",
            "redirection",
            "current_grade_or_report_handoff",
            "consolidation"
          ]
        },
        "topic_action": {
          "type": "string",
          "enum": [
            "stay_on_topic",
            "change_probe_type",
            "move_to_breadth",
            "consolidate",
            "repair_interaction",
            "redirect",
            "procedural_handoff",
            "offer_student_choice",
            "no_further_question"
          ]
        },
        "challenge_level": {
          "type": "string",
          "enum": [
            "normal",
            "elevated",
            "high"
          ]
        },
        "materiality_of_next_question": {
          "type": "string",
          "enum": [
            "material",
            "low_value",
            "not_asking_question"
          ]
        },
        "answer_feedback_cycle_feasible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "student_agency_signal": {
          "type": "string",
          "enum": [
            "wants_continue",
            "wants_improvement_path",
            "wants_move_on",
            "fatigue_or_declining_traction",
            "neutral_or_unclear"
          ]
        },
        "rationale": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "self_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_evidence_verified_before_mastery_update",
        "canonical_topic_ids_checked",
        "assisted_evidence_cap_checked",
        "high_mastery_independence_checked",
        "next_question_materiality_checked",
        "adequate_evidence_or_low_value_stop_checked",
        "closing_pressure_checked",
        "timing_basis",
        "student_agency_checked",
        "continuation_path_checked",
        "repeated_repair_strategy_change_checked"
      ],
      "properties": {
        "content_evidence_verified_before_mastery_update": {
          "type": "boolean"
        },
        "canonical_topic_ids_checked": {
          "type": "boolean"
        },
        "assisted_evidence_cap_checked": {
          "type": "boolean"
        },
        "high_mastery_independence_checked": {
          "type": "boolean"
        },
        "next_question_materiality_checked": {
          "type": "boolean"
        },
        "adequate_evidence_or_low_value_stop_checked": {
          "type": "boolean"
        },
        "closing_pressure_checked": {
          "type": "boolean"
        },
        "timing_basis": {
          "type": "string",
          "enum": [
            "provided_closing_pressure",
            "provided_no_closing_pressure",
            "timing_absent_or_unreliable"
          ]
        },
        "student_agency_checked": {
          "type": "boolean"
        },
        "continuation_path_checked": {
          "type": "boolean"
        },
        "repeated_repair_strategy_change_checked": {
          "type": "boolean"
        }
      }
    }
  }
}