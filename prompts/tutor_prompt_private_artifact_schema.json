{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "latest_message_evidence_gate",
    "mastery_update_check",
    "locus_decision_check",
    "visible_response_check"
  ],
  "properties": {
    "latest_message_evidence_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_message_function",
        "has_new_assessable_content",
        "new_content_evidence_summary",
        "repair_or_meta_signal",
        "gate_reason"
      ],
      "properties": {
        "latest_message_function": {
          "type": "string",
          "enum": [
            "new_content_evidence",
            "mixed_content_and_interaction",
            "procedural_support",
            "repair_or_pushback",
            "clarification_about_interaction",
            "meta_or_format_request",
            "off_task",
            "unclear"
          ]
        },
        "has_new_assessable_content": {
          "type": "boolean"
        },
        "new_content_evidence_summary": {
          "type": ["string", "null"],
          "maxLength": 400
        },
        "repair_or_meta_signal": {
          "type": ["string", "null"],
          "maxLength": 300
        },
        "gate_reason": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "mastery_update_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mastery_update_permitted",
        "mastery_updated",
        "topic_ids_considered",
        "evidence_strength",
        "assistance_level",
        "student_independence",
        "material_conceptual_error_present",
        "material_error_summary",
        "scaffolding_cap_applied",
        "conservative_update_reason"
      ],
      "properties": {
        "mastery_update_permitted": {
          "type": "boolean"
        },
        "mastery_updated": {
          "type": "boolean"
        },
        "topic_ids_considered": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_strength": {
          "type": "string",
          "enum": [
            "none",
            "vague_recognition",
            "correct_phrase_limited_reasoning",
            "supported_use",
            "independent_explanation_or_distinction",
            "independent_transfer_or_application",
            "repeated_independent_evidence",
            "unclear"
          ]
        },
        "assistance_level": {
          "type": "string",
          "enum": [
            "none_or_independent",
            "small_hint",
            "partial_frame",
            "heavy_scaffolding_or_correction",
            "repetition_or_immediate_uptake",
            "uncertain"
          ]
        },
        "student_independence": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "moderate",
            "high",
            "uncertain"
          ]
        },
        "material_conceptual_error_present": {
          "type": "boolean"
        },
        "material_error_summary": {
          "type": ["string", "null"],
          "maxLength": 400
        },
        "scaffolding_cap_applied": {
          "type": ["string", "null"],
          "enum": [
            "small_hint_cap_about_65",
            "heavy_scaffold_cap_about_50",
            "no_cap_needed",
            "uncertain_treated_as_assisted",
            null
          ]
        },
        "conservative_update_reason": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "locus_decision_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_locus_summary",
        "locus_decision",
        "exact_or_equivalent_question_already_answered",
        "leave_threshold_met",
        "traction",
        "remaining_weakness_type",
        "reason_for_locus_decision",
        "if_staying_after_apparent_success_reason",
        "next_question_relation"
      ],
      "properties": {
        "current_locus_summary": {
          "type": ["string", "null"],
          "maxLength": 300
        },
        "locus_decision": {
          "type": "string",
          "enum": [
            "stay_on_locus",
            "shift_angle_within_locus",
            "leave_locus_for_now",
            "unclear"
          ]
        },
        "exact_or_equivalent_question_already_answered": {
          "type": "boolean"
        },
        "leave_threshold_met": {
          "type": "boolean"
        },
        "traction": {
          "type": "string",
          "enum": [
            "productive",
            "stalled",
            "declining",
            "unclear"
          ]
        },
        "remaining_weakness_type": {
          "type": "string",
          "enum": [
            "material",
            "nonmaterial",
            "none",
            "unclear"
          ]
        },
        "reason_for_locus_decision": {
          "type": "string",
          "maxLength": 600
        },
        "if_staying_after_apparent_success_reason": {
          "type": ["string", "null"],
          "maxLength": 400
        },
        "next_question_relation": {
          "type": "string",
          "enum": [
            "same_locus_due_material_error",
            "transformed_check",
            "extend",
            "integrate",
            "switch_topic",
            "procedural_pivot_to_content",
            "none"
          ]
        }
      }
    },
    "visible_response_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assistant_message_summary",
        "feedback_language_calibrated",
        "strong_affirmation_used",
        "strong_affirmation_justified",
        "ends_with_one_focused_content_question",
        "asks_exactly_one_contribution",
        "avoids_forbidden_question_forms",
        "private_artifact_excluded_from_student_message",
        "state_delta_uses_allowed_keys_only",
        "visible_response_self_check_reason"
      ],
      "properties": {
        "assistant_message_summary": {
          "type": "string",
          "maxLength": 300
        },
        "feedback_language_calibrated": {
          "type": "boolean"
        },
        "strong_affirmation_used": {
          "type": "boolean"
        },
        "strong_affirmation_justified": {
          "type": "boolean"
        },
        "ends_with_one_focused_content_question": {
          "type": "boolean"
        },
        "asks_exactly_one_contribution": {
          "type": "boolean"
        },
        "avoids_forbidden_question_forms": {
          "type": "boolean"
        },
        "private_artifact_excluded_from_student_message": {
          "type": "boolean"
        },
        "state_delta_uses_allowed_keys_only": {
          "type": "boolean"
        },
        "visible_response_self_check_reason": {
          "type": "string",
          "maxLength": 700
        }
      }
    }
  }
}