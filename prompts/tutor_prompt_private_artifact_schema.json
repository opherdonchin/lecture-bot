{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "latest_message_review",
    "topic_engagement",
    "mastery_update_review",
    "next_move_review",
    "self_verification"
  ],
  "properties": {
    "latest_message_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "student_intent",
        "content_evidence_present",
        "evidence_independence",
        "evidence_summary",
        "no_content_evidence_reason"
      ],
      "properties": {
        "student_intent": {
          "type": "string",
          "enum": [
            "content_answer",
            "content_question",
            "procedural_question",
            "interaction_repair_needed",
            "redirection_needed",
            "ambiguous",
            "off_task"
          ]
        },
        "content_evidence_present": {
          "type": "boolean"
        },
        "evidence_independence": {
          "type": "string",
          "enum": [
            "independent",
            "assisted",
            "transformed_after_scaffold",
            "generic_or_fluent_but_unverified",
            "copied_or_echoed",
            "no_content_evidence",
            "mixed_or_unclear"
          ]
        },
        "evidence_summary": {
          "type": "string"
        },
        "no_content_evidence_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "procedural_turn",
            "copied_question_or_tutor_wording",
            "ambiguous_or_uninterpretable",
            "off_task_or_meta",
            "tutor_explanation_only",
            "not_applicable",
            null
          ]
        }
      }
    },
    "topic_engagement": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_id",
          "engagement_kind",
          "evidence_quality",
          "observed_dimensions",
          "evidence_note"
        ],
        "properties": {
          "topic_id": {
            "type": "string"
          },
          "engagement_kind": {
            "type": "string",
            "enum": [
              "meaningfully_engaged",
              "weak_or_vague_engagement",
              "misconception_observed",
              "procedural_reference_only",
              "not_confidently_localized"
            ]
          },
          "evidence_quality": {
            "type": "string",
            "enum": [
              "strong",
              "moderate",
              "weak",
              "none",
              "mixed"
            ]
          },
          "observed_dimensions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "criterion",
                "distinction",
                "explanation_why",
                "application_transfer",
                "practical_interpretation",
                "independent_correction_ownership",
                "synthesis"
              ]
            },
            "uniqueItems": true
          },
          "evidence_note": {
            "type": "string"
          }
        }
      }
    },
    "mastery_update_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "updated_state_keys_used",
        "mastery_updates_are_supported_by_latest_message",
        "high_mastery_updates_have_independent_basis",
        "scaffolding_cap_applied",
        "state_delta_rationale"
      ],
      "properties": {
        "updated_state_keys_used": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mastery",
              "evidence_notes",
              "current_topic_id",
              "tutor_comment"
            ]
          },
          "uniqueItems": true
        },
        "mastery_updates_are_supported_by_latest_message": {
          "type": "boolean"
        },
        "high_mastery_updates_have_independent_basis": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "no_high_mastery_update",
            "not_applicable"
          ]
        },
        "scaffolding_cap_applied": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "no_recent_scaffold",
            "not_applicable"
          ]
        },
        "state_delta_rationale": {
          "type": "string"
        }
      }
    },
    "next_move_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction_mode",
        "challenge_level",
        "topic_strategy",
        "probe_type",
        "material_change_rationale"
      ],
      "properties": {
        "interaction_mode": {
          "type": "string",
          "enum": [
            "basic_conceptual_probe",
            "evidence_feedback",
            "scaffolded_support",
            "adaptive_challenge",
            "breadth_transition",
            "procedural_support",
            "interaction_repair",
            "redirection",
            "grade_or_report_handoff"
          ]
        },
        "challenge_level": {
          "type": "string",
          "enum": [
            "normal",
            "elevated",
            "high",
            "lowered_for_support",
            "not_applicable"
          ]
        },
        "topic_strategy": {
          "type": "string",
          "enum": [
            "stay_on_topic",
            "change_probe_type",
            "move_to_breadth",
            "return_to_prior_weak_topic",
            "repair_before_content",
            "redirect_to_content"
          ]
        },
        "probe_type": {
          "type": "string",
          "enum": [
            "criterion",
            "distinction",
            "explanation_why",
            "example",
            "application_transfer",
            "practical_interpretation",
            "compression",
            "boundary_case",
            "critique",
            "synthesis",
            "procedural_answer",
            "repair_prompt",
            "redirection_prompt",
            "none"
          ]
        },
        "material_change_rationale": {
          "type": "string"
        }
      }
    },
    "self_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_evidence_check",
        "same_point_probe_value_check",
        "high_mastery_check",
        "post_scaffold_check",
        "topic_exit_check"
      ],
      "properties": {
        "content_evidence_check": {
          "type": "string",
          "enum": [
            "passed",
            "failed_no_mastery_update",
            "not_applicable"
          ]
        },
        "same_point_probe_value_check": {
          "type": "string",
          "enum": [
            "plausible_answer_would_change_assessment",
            "redundant_changed_move",
            "not_applicable"
          ]
        },
        "high_mastery_check": {
          "type": "string",
          "enum": [
            "independent_or_transformed_basis_present",
            "not_enough_for_high_mastery",
            "not_applicable"
          ]
        },
        "post_scaffold_check": {
          "type": "string",
          "enum": [
            "goes_beyond_repetition",
            "assisted_only_or_repetition",
            "no_recent_scaffold",
            "not_applicable"
          ]
        },
        "topic_exit_check": {
          "type": "string",
          "enum": [
            "enough_evidence",
            "further_probing_low_value",
            "staying_on_topic",
            "not_applicable"
          ]
        }
      }
    }
  }
}