{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turn_focus",
    "evidence_assessment",
    "next_move",
    "self_verification"
  ],
  "properties": {
    "turn_focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engaged_topic_id",
        "engaged_target",
        "student_signal"
      ],
      "properties": {
        "engaged_topic_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Backend-provided canonical topic ID if one is engaged on this turn; null if no clear topic is engaged. Do not invent IDs."
        },
        "engaged_target": {
          "type": "string",
          "description": "Short plain-language description of the conceptual target engaged or attempted on this turn."
        },
        "student_signal": {
          "type": "string",
          "enum": [
            "none",
            "confidence",
            "frustration",
            "fatigue",
            "move_on",
            "disagreement",
            "request_more",
            "grade_request",
            "procedural",
            "non_answer"
          ],
          "description": "Most salient student signal affecting the next move."
        }
      }
    },
    "evidence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_engagement",
        "evidence_independence",
        "local_adaptation",
        "cognitive_operation",
        "scaffolding_status",
        "evidence_strength",
        "material_uncertainty"
      ],
      "properties": {
        "content_engagement": {
          "type": "string",
          "enum": [
            "substantive",
            "procedural",
            "off_track",
            "echo_only",
            "non_answer"
          ]
        },
        "evidence_independence": {
          "type": "string",
          "enum": [
            "independent",
            "assisted",
            "copied_or_echoed",
            "generic_or_external",
            "transformed_after_support",
            "unclear"
          ]
        },
        "local_adaptation": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "none"
          ]
        },
        "cognitive_operation": {
          "type": "string",
          "enum": [
            "define",
            "distinguish",
            "explain",
            "apply",
            "critique",
            "repair",
            "compress",
            "synthesize",
            "interpret",
            "procedural",
            "other"
          ]
        },
        "scaffolding_status": {
          "type": "string",
          "enum": [
            "none",
            "after_small_hint",
            "after_substantial_explanation",
            "after_correction",
            "unclear"
          ]
        },
        "evidence_strength": {
          "type": "string",
          "enum": [
            "none",
            "weak",
            "developing",
            "solid",
            "strong",
            "robust"
          ],
          "description": "Qualitative evidence strength for this turn, interpreted conservatively."
        },
        "material_uncertainty": {
          "type": "string",
          "description": "Brief note on the most consequential remaining uncertainty, or 'none material' if none remains."
        }
      }
    },
    "next_move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_mode",
        "breadth_depth_choice",
        "expected_value",
        "question_feasible"
      ],
      "properties": {
        "selected_mode": {
          "type": "string",
          "enum": [
            "basic_probe",
            "evidence_feedback",
            "scaffolded_support",
            "adaptive_challenge",
            "breadth_transition",
            "depth_probe_strong_topic",
            "coverage_transparency",
            "procedural_support",
            "interaction_repair",
            "redirection",
            "grade_or_report_handoff",
            "consolidation",
            "terminal_closure_under_request_pressure",
            "plateau_cause_disclosure"
          ]
        },
        "breadth_depth_choice": {
          "type": "string",
          "enum": [
            "breadth",
            "depth",
            "stay",
            "consolidate",
            "close",
            "not_applicable"
          ]
        },
        "expected_value": {
          "type": "string",
          "enum": [
            "material",
            "limited",
            "none"
          ],
          "description": "Whether the chosen move is expected to materially improve characterization."
        },
        "question_feasible": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown_no_timing_data"
          ],
          "description": "Whether there is enough room for a substantive answer-feedback cycle, based only on supplied timing metadata when available."
        }
      }
    },
    "self_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_message_has_content_evidence",
        "target_not_already_substantively_addressed",
        "plausible_answer_would_materially_change_characterization",
        "chosen_move_beats_main_alternative",
        "timing_check",
        "strong_evidence_not_based_on_fluency_alone",
        "student_signals_honored",
        "prose_consistent_with_intended_move",
        "coverage_transparency_considered"
      ],
      "properties": {
        "latest_message_has_content_evidence": {
          "type": "boolean"
        },
        "target_not_already_substantively_addressed": {
          "type": "boolean"
        },
        "plausible_answer_would_materially_change_characterization": {
          "type": "boolean"
        },
        "chosen_move_beats_main_alternative": {
          "type": "boolean"
        },
        "timing_check": {
          "type": "string",
          "enum": [
            "feasible",
            "not_feasible",
            "not_applicable_no_substantive_question",
            "unknown_no_timing_data"
          ]
        },
        "strong_evidence_not_based_on_fluency_alone": {
          "type": "boolean"
        },
        "student_signals_honored": {
          "type": "boolean"
        },
        "prose_consistent_with_intended_move": {
          "type": "boolean"
        },
        "coverage_transparency_considered": {
          "type": "boolean"
        }
      }
    }
  }
}