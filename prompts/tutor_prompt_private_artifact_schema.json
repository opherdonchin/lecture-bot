{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turn_evidence",
    "next_move_decision",
    "self_verification"
  ],
  "properties": {
    "turn_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "student_message_type",
        "topic_id",
        "evidence_independence",
        "evidence_strength",
        "demonstrated_dimensions",
        "mastery_update_supported",
        "brief_basis"
      ],
      "properties": {
        "student_message_type": {
          "type": "string",
          "enum": [
            "content_answer",
            "content_question",
            "procedural_question",
            "grade_or_report_request",
            "request_for_hidden_internals",
            "out_of_scope",
            "non_answer_or_repair_needed"
          ]
        },
        "topic_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Canonical backend-provided topic ID, or null when no topic can be identified without invention."
        },
        "evidence_independence": {
          "type": "string",
          "enum": [
            "none",
            "independent",
            "after_small_hint",
            "after_substantial_scaffold",
            "generic_or_fluent_only",
            "copied_or_echoed",
            "transformed_verification"
          ]
        },
        "evidence_strength": {
          "type": "string",
          "enum": [
            "none",
            "weaker",
            "moderate",
            "strong"
          ]
        },
        "demonstrated_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "criterion",
              "distinction",
              "explanation",
              "application",
              "interpretation",
              "ownership",
              "synthesis"
            ]
          },
          "uniqueItems": true
        },
        "mastery_update_supported": {
          "type": "boolean"
        },
        "brief_basis": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "next_move_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_mode",
        "conceptual_target",
        "target_already_addressed",
        "breadth_depth_choice",
        "marginal_value",
        "question_asked",
        "coverage_transparency_considered",
        "closing_pressure_considered",
        "decision_basis"
      ],
      "properties": {
        "selected_mode": {
          "type": "string",
          "enum": [
            "basic_probe",
            "evidence_feedback",
            "scaffolded_support",
            "adaptive_challenge",
            "breadth_transition",
            "depth_probe_on_strong_topic",
            "coverage_transparency",
            "procedural_support",
            "interaction_repair",
            "redirection",
            "grade_or_report_handoff",
            "consolidation",
            "terminal_closure_under_request_pressure",
            "plateau_cause_disclosure"
          ]
        },
        "conceptual_target": {
          "type": [
            "string",
            "null"
          ],
          "description": "Short private description of the concept or operation targeted by the next move; null for procedural, redirection, handoff, or closure moves."
        },
        "target_already_addressed": {
          "type": "boolean"
        },
        "breadth_depth_choice": {
          "type": "string",
          "enum": [
            "not_applicable",
            "breadth",
            "depth",
            "scaffold_or_repair",
            "procedural_or_redirect",
            "consolidate_or_close"
          ]
        },
        "marginal_value": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "material"
          ]
        },
        "question_asked": {
          "type": "boolean"
        },
        "coverage_transparency_considered": {
          "type": "boolean"
        },
        "closing_pressure_considered": {
          "type": "boolean"
        },
        "decision_basis": {
          "type": "string",
          "maxLength": 800
        }
      }
    },
    "self_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_content_evidence_gate_checked",
        "no_reprobe_of_substantively_addressed_target",
        "next_probe_material_if_present",
        "breadth_depth_marginal_gain_checked",
        "answer_feedback_cycle_feasible",
        "high_mastery_supported_by_independent_evidence",
        "student_signals_honored",
        "prose_matches_structured_decision",
        "coverage_transparency_checked_when_relevant"
      ],
      "properties": {
        "actual_content_evidence_gate_checked": {
          "type": "boolean"
        },
        "no_reprobe_of_substantively_addressed_target": {
          "type": "boolean"
        },
        "next_probe_material_if_present": {
          "type": "boolean"
        },
        "breadth_depth_marginal_gain_checked": {
          "type": "boolean"
        },
        "answer_feedback_cycle_feasible": {
          "type": "boolean"
        },
        "high_mastery_supported_by_independent_evidence": {
          "type": "boolean"
        },
        "student_signals_honored": {
          "type": "boolean"
        },
        "prose_matches_structured_decision": {
          "type": "boolean"
        },
        "coverage_transparency_checked_when_relevant": {
          "type": "boolean"
        }
      }
    }
  }
}
