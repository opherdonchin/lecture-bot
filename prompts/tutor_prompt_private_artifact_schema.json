{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turn_assessment",
    "next_move",
    "self_verification"
  ],
  "properties": {
    "turn_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_message_type",
        "engaged_topic_id",
        "evidence_strength",
        "independence_level",
        "demonstrated_dimensions",
        "remaining_uncertainties",
        "substantive_target_already_addressed"
      ],
      "properties": {
        "latest_message_type": {
          "type": "string",
          "enum": [
            "content_answer",
            "content_question",
            "procedural_question",
            "repair_case",
            "redirection_case",
            "mixed",
            "unclear"
          ]
        },
        "engaged_topic_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_strength": {
          "type": "string",
          "enum": [
            "none",
            "weak",
            "moderate",
            "strong"
          ]
        },
        "independence_level": {
          "type": "string",
          "enum": [
            "independent",
            "assisted_after_small_hint",
            "assisted_after_substantial_scaffold",
            "generic_or_copied",
            "procedural_only",
            "unclear"
          ]
        },
        "demonstrated_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "criterion",
              "distinction",
              "explanation",
              "application",
              "interpretation",
              "ownership",
              "synthesis"
            ]
          },
          "uniqueItems": true
        },
        "remaining_uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "substantive_target_already_addressed": {
          "type": "boolean"
        }
      }
    },
    "next_move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "question_substance",
        "materiality_rationale",
        "breadth_depth_choice",
        "closing_pressure_considered",
        "student_signals_considered",
        "coverage_transparency_considered"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "opening",
            "basic_probe",
            "evidence_feedback",
            "scaffolded_support",
            "adaptive_challenge",
            "breadth_transition",
            "depth_probe_on_strong_topic",
            "coverage_transparency",
            "procedural_support",
            "interaction_repair",
            "redirection",
            "grade_or_report_handoff",
            "consolidation",
            "terminal_closure_under_recurring_request_pressure",
            "plateau_cause_disclosure"
          ]
        },
        "question_substance": {
          "type": "string",
          "enum": [
            "substantive_question",
            "no_substantive_question"
          ]
        },
        "materiality_rationale": {
          "type": "string"
        },
        "breadth_depth_choice": {
          "type": "string",
          "enum": [
            "breadth",
            "depth",
            "neither"
          ]
        },
        "closing_pressure_considered": {
          "type": "boolean"
        },
        "student_signals_considered": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "fatigue",
              "move_on_request",
              "declining_traction",
              "frustration",
              "anxiety",
              "grade_request",
              "grade_frustration",
              "request_for_more_low_value_probing",
              "request_for_hidden_internals",
              "copy_paste_loop",
              "disagreement",
              "out_of_scope_request"
            ]
          },
          "uniqueItems": true
        },
        "coverage_transparency_considered": {
          "type": "boolean"
        }
      }
    },
    "self_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_evidence_gate_passed",
        "repetition_check_passed",
        "materiality_check_passed",
        "breadth_vs_depth_check_passed",
        "time_feasibility_check_passed",
        "high_mastery_evidence_check_passed",
        "student_signal_honoring_check_passed",
        "prose_consistency_check_passed",
        "plateau_coverage_check_passed"
      ],
      "properties": {
        "content_evidence_gate_passed": {
          "type": "boolean"
        },
        "repetition_check_passed": {
          "type": "boolean"
        },
        "materiality_check_passed": {
          "type": "boolean"
        },
        "breadth_vs_depth_check_passed": {
          "type": "boolean"
        },
        "time_feasibility_check_passed": {
          "type": "boolean"
        },
        "high_mastery_evidence_check_passed": {
          "type": "boolean"
        },
        "student_signal_honoring_check_passed": {
          "type": "boolean"
        },
        "prose_consistency_check_passed": {
          "type": "boolean"
        },
        "plateau_coverage_check_passed": {
          "type": "boolean"
        }
      }
    }
  }
}