{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "latest_message_assessment",
    "topic_evidence",
    "next_move_decision",
    "self_verification",
    "state_delta_check",
    "student_facing_boundary_check"
  ],
  "properties": {
    "latest_message_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_kind",
        "content_evidence_present",
        "evidence_independence",
        "student_signal",
        "brief_observation"
      ],
      "properties": {
        "turn_kind": {
          "type": "string",
          "enum": [
            "content_answer",
            "content_question",
            "procedural_question",
            "interaction_repair_needed",
            "redirection_needed",
            "ambiguous_or_off_task"
          ]
        },
        "content_evidence_present": {
          "type": "boolean"
        },
        "evidence_independence": {
          "type": "string",
          "enum": [
            "independent",
            "assisted_by_small_hint",
            "assisted_by_substantial_scaffold",
            "copied_or_echoed",
            "procedural_or_none",
            "ambiguous"
          ]
        },
        "student_signal": {
          "type": "string",
          "enum": [
            "normal_engagement",
            "strong_fluent_answer",
            "stuck_or_confused",
            "frustrated_or_anxious",
            "fatigue_or_low_traction",
            "wants_to_move_on",
            "asks_for_grade_or_report",
            "asks_for_hidden_or_forbidden_internals",
            "unclear"
          ]
        },
        "brief_observation": {
          "type": "string",
          "maxLength": 280
        }
      }
    },
    "topic_evidence": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_id",
          "engagement_basis",
          "evidence_quality",
          "demonstrated_dimensions",
          "mastery_update_decision",
          "brief_rationale"
        ],
        "properties": {
          "topic_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "engagement_basis": {
            "type": "string",
            "maxLength": 220
          },
          "evidence_quality": {
            "type": "string",
            "enum": [
              "no_content_evidence",
              "weak",
              "emerging",
              "strong",
              "high"
            ]
          },
          "demonstrated_dimensions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "criterion",
                "distinction",
                "explanation_why",
                "application_transfer",
                "practical_interpretation",
                "independent_correction_ownership",
                "synthesis",
                "compression",
                "critique"
              ]
            }
          },
          "mastery_update_decision": {
            "type": "string",
            "enum": [
              "no_update",
              "record_weak_or_limited_evidence",
              "update_provisional_mastery",
              "cap_as_assisted_evidence",
              "record_limitation_or_uncertainty"
            ]
          },
          "brief_rationale": {
            "type": "string",
            "maxLength": 280
          }
        }
      }
    },
    "next_move_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction_mode",
        "topic_strategy",
        "challenge_level",
        "asks_substantive_question",
        "materiality_of_next_question",
        "answer_feedback_cycle_feasible",
        "brief_rationale"
      ],
      "properties": {
        "interaction_mode": {
          "type": "string",
          "enum": [
            "basic_conceptual_probe",
            "evidence_feedback",
            "scaffolded_support",
            "adaptive_challenge",
            "breadth_transition",
            "procedural_support",
            "interaction_repair",
            "redirection",
            "consolidation"
          ]
        },
        "topic_strategy": {
          "type": "string",
          "enum": [
            "stay_on_current_topic",
            "change_probe_type",
            "move_to_new_topic",
            "consolidate_or_close",
            "answer_procedural_then_return",
            "repair_before_assessing"
          ]
        },
        "challenge_level": {
          "type": "string",
          "enum": [
            "normal",
            "elevated",
            "high",
            "not_applicable"
          ]
        },
        "asks_substantive_question": {
          "type": "boolean"
        },
        "materiality_of_next_question": {
          "type": "string",
          "enum": [
            "consequential",
            "minor_or_polish_only",
            "not_applicable"
          ]
        },
        "answer_feedback_cycle_feasible": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown_due_absent_or_unreliable_timing",
            "not_applicable"
          ]
        },
        "brief_rationale": {
          "type": "string",
          "maxLength": 320
        }
      }
    },
    "self_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_content_before_mastery_update",
        "post_scaffold_not_overcredited",
        "high_mastery_requires_independent_transformed_evidence",
        "same_point_question_is_material",
        "question_after_adequate_evidence_is_consequential",
        "closing_pressure_checked",
        "student_agency_signal_respected",
        "topic_end_condition_checked"
      ],
      "properties": {
        "actual_content_before_mastery_update": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "post_scaffold_not_overcredited": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "high_mastery_requires_independent_transformed_evidence": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "same_point_question_is_material": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "question_after_adequate_evidence_is_consequential": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "closing_pressure_checked": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "unknown_due_absent_or_unreliable_timing",
            "not_applicable"
          ]
        },
        "student_agency_signal_respected": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "topic_end_condition_checked": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        }
      }
    },
    "state_delta_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_updated_state_keys_used",
        "content_evidence_supports_delta",
        "backend_owned_updates_avoided",
        "canonical_topic_ids_only"
      ],
      "properties": {
        "allowed_updated_state_keys_used": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "mastery",
              "evidence_notes",
              "current_topic_id",
              "tutor_comment"
            ]
          }
        },
        "content_evidence_supports_delta": {
          "type": "string",
          "enum": [
            "yes",
            "no_delta",
            "no"
          ]
        },
        "backend_owned_updates_avoided": {
          "type": "boolean",
          "const": true
        },
        "canonical_topic_ids_only": {
          "type": "string",
          "enum": [
            "yes",
            "no_topic_ids_used",
            "uncertain"
          ]
        }
      }
    },
    "student_facing_boundary_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_artifact_excluded_from_student_message",
        "hidden_internals_not_revealed",
        "no_ai_use_accusation_or_detection",
        "no_authoritative_grade_or_report_claim"
      ],
      "properties": {
        "private_artifact_excluded_from_student_message": {
          "type": "boolean",
          "const": true
        },
        "hidden_internals_not_revealed": {
          "type": "boolean",
          "const": true
        },
        "no_ai_use_accusation_or_detection": {
          "type": "boolean",
          "const": true
        },
        "no_authoritative_grade_or_report_claim": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}