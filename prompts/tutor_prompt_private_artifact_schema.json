{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "turn_classification": {
      "type": "string",
      "enum": [
        "content_answer",
        "content_question",
        "procedural_request",
        "hidden_internals_request",
        "off_task",
        "student_wants_to_stop"
      ]
    },
    "response_mode": {
      "type": "string",
      "enum": [
        "ordinary_probe",
        "evidence_feedback",
        "scaffolded_support",
        "adaptive_challenge",
        "topic_transition",
        "procedural_support",
        "redirection",
        "lifecycle_closing"
      ]
    },
    "student_signal_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lecture_relevant_conceptual_work": {
          "type": "string",
          "enum": [
            "yes",
            "partial",
            "no"
          ]
        },
        "locally_responsive": {
          "type": "string",
          "enum": [
            "yes",
            "partial",
            "no",
            "not_applicable"
          ]
        },
        "apparent_answer_source": {
          "type": "string",
          "enum": [
            "independent",
            "scaffolded",
            "generic",
            "copied",
            "transformed",
            "mixed",
            "unclear",
            "not_applicable"
          ]
        },
        "recent_tutor_support_limits_strength": {
          "type": "boolean"
        },
        "student_affect_or_intent": {
          "type": "string",
          "enum": [
            "frustrated",
            "fatigued",
            "confident",
            "uncertain",
            "wants_to_stop",
            "none_clear"
          ]
        }
      },
      "required": [
        "lecture_relevant_conceptual_work",
        "locally_responsive",
        "apparent_answer_source",
        "recent_tutor_support_limits_strength",
        "student_affect_or_intent"
      ]
    },
    "evidence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "has_evidence_of_understanding": {
          "type": "boolean"
        },
        "engaged_topic_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_strength": {
          "type": "string",
          "enum": [
            "none",
            "weak",
            "developing",
            "solid",
            "strong",
            "robust"
          ]
        },
        "independence_level": {
          "type": "string",
          "enum": [
            "not_applicable",
            "assisted",
            "mixed",
            "independent"
          ]
        },
        "criteria_observed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "criterion",
              "distinction",
              "explanation",
              "application",
              "interpretation",
              "repair",
              "ownership",
              "synthesis"
            ]
          },
          "uniqueItems": true
        },
        "weaker_evidence_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vague_relevance",
              "isolated_terminology",
              "agreement_only",
              "generic_prose",
              "copied_wording",
              "post_hint_repetition",
              "correct_but_nonresponsive",
              "fluent_without_local_adaptation"
            ]
          },
          "uniqueItems": true
        },
        "needs_transformed_verification": {
          "type": "boolean"
        }
      },
      "required": [
        "has_evidence_of_understanding",
        "engaged_topic_ids",
        "evidence_strength",
        "independence_level",
        "criteria_observed",
        "weaker_evidence_flags",
        "needs_transformed_verification"
      ]
    },
    "guidance_following": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "explicit_topic_or_move_guidance_present": {
          "type": "boolean"
        },
        "followed_guidance": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "not_applicable"
          ]
        },
        "selected_next_topic_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_basis": {
          "type": "string",
          "enum": [
            "explicit_guidance",
            "important_weak_or_untested_area",
            "adaptive_challenge_after_strong_evidence",
            "repair_after_error",
            "student_question_or_need",
            "lifecycle_closing",
            "redirection",
            "procedural_pivot"
          ]
        }
      },
      "required": [
        "explicit_topic_or_move_guidance_present",
        "followed_guidance",
        "selected_next_topic_id",
        "selection_basis"
      ]
    },
    "message_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feedback_intent": {
          "type": "string"
        },
        "next_question_intent": {
          "type": "string"
        },
        "question_type": {
          "type": "string",
          "enum": [
            "criterion",
            "distinction",
            "explanation",
            "application",
            "interpretation",
            "repair",
            "compression",
            "critique",
            "boundary_case",
            "synthesis",
            "none"
          ]
        },
        "closing_language_used": {
          "type": "boolean"
        },
        "new_substantive_question_included": {
          "type": "boolean"
        }
      },
      "required": [
        "feedback_intent",
        "next_question_intent",
        "question_type",
        "closing_language_used",
        "new_substantive_question_included"
      ]
    },
    "self_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assistant_message_matches_mode": {
          "type": "boolean"
        },
        "avoids_hidden_internals_or_answer_keys": {
          "type": "boolean"
        },
        "avoids_unsupported_completion_claims": {
          "type": "boolean"
        },
        "avoids_fabricated_timing_or_lifecycle_claims": {
          "type": "boolean"
        },
        "keeps_private_content_out_of_student_message": {
          "type": "boolean"
        }
      },
      "required": [
        "assistant_message_matches_mode",
        "avoids_hidden_internals_or_answer_keys",
        "avoids_unsupported_completion_claims",
        "avoids_fabricated_timing_or_lifecycle_claims",
        "keeps_private_content_out_of_student_message"
      ]
    }
  },
  "required": [
    "turn_classification",
    "response_mode",
    "student_signal_summary",
    "evidence_assessment",
    "guidance_following",
    "message_plan",
    "self_check"
  ]
}