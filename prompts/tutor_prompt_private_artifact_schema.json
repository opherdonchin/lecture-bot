{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "student_attention",
    "pedagogical_judgment",
    "mastery_judgment",
    "locus_judgment",
    "self_verification",
    "response_form_check"
  ],
  "properties": {
    "student_attention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engagement",
        "momentum",
        "current_goal",
        "assistance_level",
        "independence_of_understanding",
        "traction_on_current_locus"
      ],
      "properties": {
        "engagement": {
          "type": "string",
          "enum": ["productive", "hesitant", "passive", "off_task", "unclear"]
        },
        "momentum": {
          "type": "string",
          "enum": ["clarifying", "stalled", "drifting", "declining", "unclear"]
        },
        "current_goal": {
          "type": "string",
          "enum": ["answering", "learning", "clarifying", "challenging", "improving_grade", "procedural_help", "unclear"]
        },
        "assistance_level": {
          "type": "string",
          "enum": ["none", "small_hint", "partial_frame", "heavy_scaffolding", "correction", "unclear"]
        },
        "independence_of_understanding": {
          "type": "string",
          "enum": ["independent", "partly_assisted", "mostly_assisted", "recognition_only", "unclear"]
        },
        "traction_on_current_locus": {
          "type": "string",
          "enum": ["productive", "limited", "repetitive", "low_yield", "counterproductive", "unclear"]
        }
      }
    },
    "pedagogical_judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_move", "reason"],
      "properties": {
        "next_move": {
          "type": "string",
          "enum": [
            "open_question",
            "contrast_question",
            "example_request",
            "application_prompt",
            "why_prompt",
            "small_hint",
            "partial_frame",
            "correction",
            "brief_summary_then_question",
            "procedural_support_then_question",
            "redirection_then_question"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mastery_judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_id",
        "evidence_strength",
        "evidence_basis",
        "mastery_update_warranted",
        "mastery_score_if_updated",
        "reason"
      ],
      "properties": {
        "topic_id": {
          "type": ["string", "null"]
        },
        "evidence_strength": {
          "type": "string",
          "enum": [
            "no_new_evidence",
            "vague_recognition",
            "correct_phrase_limited_reasoning",
            "supported_use",
            "independent_explanation",
            "independent_transfer",
            "repeated_independent_evidence"
          ]
        },
        "evidence_basis": {
          "type": "string",
          "enum": [
            "none",
            "identification",
            "criterion",
            "distinction",
            "explanation",
            "application",
            "example_or_counterexample",
            "practical_interpretation",
            "independent_correction"
          ]
        },
        "mastery_update_warranted": {
          "type": "boolean"
        },
        "mastery_score_if_updated": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "locus_judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_topic_id",
        "decision",
        "material_conceptual_error_present",
        "adequate_for_local_purpose",
        "right_enough_for_now",
        "specific_reason_to_stay",
        "reason"
      ],
      "properties": {
        "current_topic_id": {
          "type": ["string", "null"]
        },
        "decision": {
          "type": "string",
          "enum": ["stay", "shift_angle", "leave_for_now"]
        },
        "material_conceptual_error_present": {
          "type": "boolean"
        },
        "adequate_for_local_purpose": {
          "type": "boolean"
        },
        "right_enough_for_now": {
          "type": "boolean"
        },
        "specific_reason_to_stay": {
          "type": ["string", "null"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "self_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "student_carried_conceptual_work",
        "not_merely_repetition_or_uptake",
        "feedback_language_matches_evidence",
        "pedagogical_move_without_mastery_inflation",
        "remaining_weakness_material",
        "another_same_locus_turn_worthwhile"
      ],
      "properties": {
        "student_carried_conceptual_work": {
          "type": "boolean"
        },
        "not_merely_repetition_or_uptake": {
          "type": "boolean"
        },
        "feedback_language_matches_evidence": {
          "type": "boolean"
        },
        "pedagogical_move_without_mastery_inflation": {
          "type": "boolean"
        },
        "remaining_weakness_material": {
          "type": "boolean"
        },
        "another_same_locus_turn_worthwhile": {
          "type": "boolean"
        }
      }
    },
    "response_form_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ends_with_one_content_question",
        "question_requests_one_contribution",
        "not_single_sentence_summary_request",
        "not_topic_menu",
        "reason"
      ],
      "properties": {
        "ends_with_one_content_question": {
          "type": "boolean"
        },
        "question_requests_one_contribution": {
          "type": "boolean"
        },
        "not_single_sentence_summary_request": {
          "type": "boolean"
        },
        "not_topic_menu": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}