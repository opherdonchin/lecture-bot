{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "student_message_assessment",
    "next_move",
    "route_position",
    "help_given",
    "self_check"
  ],
  "properties": {
    "student_message_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "what_student_did_with_idea",
        "response_alignment",
        "evidence_strength",
        "evidence_independence",
        "affect_or_state"
      ],
      "properties": {
        "message_type": {
          "type": "string",
          "description": "What kind of message this was for tutoring purposes.",
          "enum": [
            "content",
            "procedure",
            "off_task",
            "mixed"
          ]
        },
        "what_student_did_with_idea": {
          "type": "string",
          "description": "Brief account of whether the student used, explained, repeated, avoided, or otherwise worked with the idea."
        },
        "response_alignment": {
          "type": "string",
          "description": "Whether and how the student's message responded to what was asked, including if it went somewhere useful instead."
        },
        "evidence_strength": {
          "type": "string",
          "description": "How strong the evidence in this turn was.",
          "enum": [
            "none",
            "weak",
            "developing",
            "solid",
            "strong",
            "robust"
          ]
        },
        "evidence_independence": {
          "type": "string",
          "description": "How independent the evidence was.",
          "enum": [
            "assisted",
            "partly_independent",
            "independent",
            "not_applicable"
          ]
        },
        "affect_or_state": {
          "type": "string",
          "description": "Observed engagement, impatience, tiredness, confusion, frustration, or other relevant student state."
        }
      }
    },
    "next_move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chosen_mode",
        "move_description",
        "why_chosen"
      ],
      "properties": {
        "chosen_mode": {
          "type": "string",
          "description": "Interaction mode chosen for this turn.",
          "enum": [
            "working_a_step",
            "teaching",
            "answering",
            "unsticking",
            "offering_a_way_on",
            "exploring",
            "landing"
          ]
        },
        "move_description": {
          "type": "string",
          "description": "What the tutor chose to do next."
        },
        "why_chosen": {
          "type": "string",
          "description": "Why this move was chosen, including relation to the student's message, route, time, or evidence."
        }
      }
    },
    "route_position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_or_focus",
        "current_stop",
        "student_steered"
      ],
      "properties": {
        "route_or_focus": {
          "type": "string",
          "description": "Current route, route fragment, or student-chosen focus."
        },
        "current_stop": {
          "type": "string",
          "description": "Current stop or immediate conceptual location."
        },
        "student_steered": {
          "type": "boolean",
          "description": "Whether the student determined the direction of this turn."
        }
      }
    },
    "help_given": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "help_level",
        "help_description",
        "why_this_much"
      ],
      "properties": {
        "help_level": {
          "type": "string",
          "description": "How much help the tutor gave.",
          "enum": [
            "none",
            "minimal_nudge",
            "hint",
            "partial_path",
            "full_explanation",
            "full_answer"
          ]
        },
        "help_description": {
          "type": "string",
          "description": "What help was actually given."
        },
        "why_this_much": {
          "type": "string",
          "description": "Why this amount of help was appropriate."
        }
      }
    },
    "self_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at_most_one_question",
        "student_has_needed_context",
        "no_verdict_on_student_or_completion",
        "no_above_developing_from_assisted_only",
        "notes"
      ],
      "properties": {
        "at_most_one_question": {
          "type": "boolean"
        },
        "student_has_needed_context": {
          "type": "boolean"
        },
        "no_verdict_on_student_or_completion": {
          "type": "boolean"
        },
        "no_above_developing_from_assisted_only": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "description": "Short note on any self-check concern, repair, or confirmation."
        }
      }
    }
  }
}