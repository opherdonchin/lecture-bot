{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "student_message_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message_type": {
          "type": "string",
          "enum": [
            "content",
            "procedure",
            "off_task",
            "mixed"
          ]
        },
        "what_student_did_with_idea": {
          "type": "string"
        },
        "responsiveness": {
          "type": "string",
          "enum": [
            "answered",
            "did_not_answer_but_went_somewhere_good",
            "did_not_answer_and_did_not_advance",
            "not_applicable"
          ]
        },
        "independence_of_work": {
          "type": "string",
          "enum": [
            "independent",
            "partly_assisted",
            "assisted",
            "not_applicable"
          ]
        },
        "evidence_strength": {
          "type": "string",
          "enum": [
            "none",
            "weak",
            "developing",
            "solid",
            "strong",
            "robust"
          ]
        },
        "error_status": {
          "type": "string",
          "enum": [
            "no_material_error",
            "material_error",
            "skipped_step_only",
            "unclear"
          ]
        },
        "student_state": {
          "type": "string",
          "enum": [
            "engaged",
            "impatient",
            "tired",
            "lost",
            "frustrated",
            "distressed",
            "unclear"
          ]
        }
      },
      "required": [
        "message_type",
        "what_student_did_with_idea",
        "responsiveness",
        "independence_of_work",
        "evidence_strength",
        "error_status",
        "student_state"
      ]
    },
    "turn_pedagogical_decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interaction_mode": {
          "type": "string",
          "enum": [
            "working_a_step",
            "teaching",
            "answering",
            "unsticking",
            "offering_a_way_on",
            "exploring",
            "landing"
          ]
        },
        "next_move": {
          "type": "string"
        },
        "why_this_move": {
          "type": "string"
        },
        "student_steered": {
          "type": "boolean"
        },
        "help_level_given": {
          "type": "string",
          "enum": [
            "minimal_prompt",
            "hint",
            "multiple_choice",
            "one_piece_of_path",
            "direct_explanation",
            "full_answer",
            "no_content_help"
          ]
        },
        "why_this_help_level": {
          "type": "string"
        }
      },
      "required": [
        "interaction_mode",
        "next_move",
        "why_this_move",
        "student_steered",
        "help_level_given",
        "why_this_help_level"
      ]
    },
    "route_position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route_name_or_status": {
          "type": "string"
        },
        "current_stop_or_focus": {
          "type": "string"
        },
        "movement_status": {
          "type": "string",
          "enum": [
            "staying_on_current_stop",
            "moving_to_new_stop",
            "student_started_mid_route",
            "off_route_by_student_choice",
            "beyond_lecture_or_route",
            "landing"
          ]
        }
      },
      "required": [
        "route_name_or_status",
        "current_stop_or_focus",
        "movement_status"
      ]
    },
    "self_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at_most_one_question": {
          "type": "boolean"
        },
        "student_has_needed_context": {
          "type": "boolean"
        },
        "no_verdict_on_student_or_completion": {
          "type": "boolean"
        },
        "no_topic_above_developing_based_only_on_assisted_answers": {
          "type": "boolean"
        },
        "issues_if_any": {
          "type": "string"
        }
      },
      "required": [
        "at_most_one_question",
        "student_has_needed_context",
        "no_verdict_on_student_or_completion",
        "no_topic_above_developing_based_only_on_assisted_answers",
        "issues_if_any"
      ]
    }
  },
  "required": [
    "student_message_assessment",
    "turn_pedagogical_decision",
    "route_position",
    "self_check"
  ]
}