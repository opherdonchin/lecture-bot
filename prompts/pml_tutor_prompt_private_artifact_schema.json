{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "student_message_assessment",
    "turn_pedagogical_decision",
    "route_tracking",
    "help_calibration",
    "self_check"
  ],
  "properties": {
    "student_message_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what_student_did",
        "evidence_strength",
        "evidence_independence"
      ],
      "properties": {
        "what_student_did": {
          "type": "string"
        },
        "evidence_strength": {
          "type": "string"
        },
        "evidence_independence": {
          "type": "string"
        }
      }
    },
    "turn_pedagogical_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_move",
        "why_chosen"
      ],
      "properties": {
        "next_move": {
          "type": "string"
        },
        "why_chosen": {
          "type": "string"
        }
      }
    },
    "route_tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_or_path",
        "current_stop",
        "student_steered"
      ],
      "properties": {
        "route_or_path": {
          "type": "string"
        },
        "current_stop": {
          "type": "string"
        },
        "student_steered": {
          "type": "boolean"
        }
      }
    },
    "help_calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "help_given",
        "why_this_much"
      ],
      "properties": {
        "help_given": {
          "type": "string"
        },
        "why_this_much": {
          "type": "string"
        }
      }
    },
    "self_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at_most_one_question",
        "context_sufficient",
        "no_completion_verdict"
      ],
      "properties": {
        "at_most_one_question": {
          "type": "boolean"
        },
        "context_sufficient": {
          "type": "boolean"
        },
        "no_completion_verdict": {
          "type": "boolean"
        }
      }
    }
  }
}