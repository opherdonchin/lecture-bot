{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turn_read",
    "turn_decision",
    "turn_checks"
  ],
  "properties": {
    "turn_read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "student_message_type",
        "what_student_did_with_idea",
        "independence_of_evidence",
        "response_alignment",
        "error_vs_skipped_step",
        "student_state",
        "route_position",
        "student_steered"
      ],
      "properties": {
        "student_message_type": {
          "type": "string",
          "enum": [
            "content",
            "procedure",
            "off_task",
            "mixed"
          ]
        },
        "what_student_did_with_idea": {
          "type": "string"
        },
        "independence_of_evidence": {
          "type": "string",
          "enum": [
            "none",
            "weak_or_unclear",
            "assisted",
            "partly_independent",
            "independent"
          ]
        },
        "response_alignment": {
          "type": "string",
          "enum": [
            "answered_what_was_asked",
            "did_not_answer_but_went_somewhere_good",
            "did_not_answer_and_needs_redirection",
            "not_applicable"
          ]
        },
        "error_vs_skipped_step": {
          "type": "string",
          "enum": [
            "real_error",
            "skipped_step",
            "both",
            "neither_or_not_applicable"
          ]
        },
        "student_state": {
          "type": "string",
          "enum": [
            "engaged",
            "impatient",
            "tired",
            "lost",
            "frustrated",
            "mixed_or_unclear"
          ]
        },
        "route_position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route_name_or_status",
            "current_stop_or_focus"
          ],
          "properties": {
            "route_name_or_status": {
              "type": "string"
            },
            "current_stop_or_focus": {
              "type": "string"
            }
          }
        },
        "student_steered": {
          "type": "boolean"
        }
      }
    },
    "turn_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction_mode",
        "next_move",
        "why_this_move",
        "help_level",
        "why_this_help_level"
      ],
      "properties": {
        "interaction_mode": {
          "type": "string",
          "enum": [
            "working_a_step",
            "teaching",
            "answering",
            "unsticking",
            "offering_a_way_on",
            "exploring",
            "landing"
          ]
        },
        "next_move": {
          "type": "string"
        },
        "why_this_move": {
          "type": "string"
        },
        "help_level": {
          "type": "string",
          "enum": [
            "minimal_nudge",
            "hint",
            "multiple_choice",
            "one_piece_of_path",
            "brief_explanation",
            "full_answer_or_explanation",
            "recap_or_landing"
          ]
        },
        "why_this_help_level": {
          "type": "string"
        }
      }
    },
    "turn_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_count_ok",
        "context_sufficient",
        "no_completion_verdict",
        "no_above_developing_from_assisted_only",
        "evidence_strength_summary"
      ],
      "properties": {
        "question_count_ok": {
          "type": "boolean"
        },
        "context_sufficient": {
          "type": "boolean"
        },
        "no_completion_verdict": {
          "type": "boolean"
        },
        "no_above_developing_from_assisted_only": {
          "type": "boolean"
        },
        "evidence_strength_summary": {
          "type": "string"
        }
      }
    }
  }
}