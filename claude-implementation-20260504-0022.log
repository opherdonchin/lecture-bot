[29C[3A[29D[3B[4A  [48;5;237m[38;5;239m❯ [38;5;231mYou are working in the lecture-bot repository.[39m                                                                                [49m  [1B  [48;5;237m                                                                                                                                [1B[49m  [48;5;237m  [38;5;231mCreate a new branch and implement the admin tutor-document archive design we have converged on.[39m                               [49m  [2C[1B[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mBegin by running:[39m                                                                                                             [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mgit checkout -b admin-tutor-document-archive[39m                                                                                  [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mIf that branch already exists, use a clear variant such as:[39m                                                                   [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mgit checkout -b admin-tutor-document-archive-2[39m                                                                                [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mDo not start by coding blindly. First inspect the current codebase, especially:[39m                                               [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231m- app/models.py[39m                                                                                                               [49m
[2C[48;5;237m  [38;5;231m- app/db.py[39m                                                                                                                   [49m
[2C[48;5;237m  [38;5;231m- app/main.py[39m                                                                                                                 [49m
[2C[48;5;237m  [38;5;231m- app/session_manager.py[39m                                                                                                      [49m
[2C[48;5;237m  [38;5;231m- app/bot_engine.py[39m                                                                                                           [49m
[2C[48;5;237m  [38;5;231m- app/prompt_loader.py[39m                                                                                                        [49m
[2C[48;5;237m  [38;5;231m- app/admin_main.py[39m                                                                                                           [49m
[2C[48;5;237m  [38;5;231m- any existing admin session/export code[39m                                                                                      [49m
[2C[48;5;237m  [38;5;231m- scripts/export_session_package.py[39m                                                                                           [49m
[2C[48;5;237m  [38;5;231m- scripts/init_db.py[39m                                                                                                          [49m
[2C[48;5;237m  [38;5;231m- docs/[39m                                                                                                                       [49m
[2C[48;5;237m  [38;5;231m- prompts/[39m                                                                                                                    [49m
[2C[48;5;237m  [38;5;231m- tests/[39m                                                                                                                      [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mThen do the following in order.[39m                                                                                               [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231m## 1. Create or update design documentation[39m                                                                                   [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mCreate a new document:[39m                                                                                                        [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mdocs/admin_tutor_document_archive_spec.md[39m                                                                                     [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mThis document should describe the final target design clearly enough that future work can be checked against it.[39m              [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mThe design is:[39m                                                                                                                [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mWe are adding a document archive to the admin system. The archive stores tutor-related documents and the typed links between [39m [49m
[2C[48;5;237m  [38;5;231mthem.[39m                                                                                                                         [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mThe core durable table is a single document table, not a tutor_versions table.[39m                                                [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mThe document table stores only structurally usable documents. Failed generations, malformed outputs, missing schemas, and [39m    [49m
[2C[48;5;237m  [38;5;231mcontract failures should not become archive documents. They belong in generation run logs.[39m                                    [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mDocument types should be exactly:[39m                                                                                             [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231m- tutor_spec[39m                                                                                                                  [49m
[2C[48;5;237m  [38;5;231m- tutor_prompt[39m                                                                                                                [49m
[2C[48;5;237m  [38;5;231m- tutor_artifact_schema[39m                                                                                                       [49m
[2C[48;5;237m  [38;5;231m- tutor_spec_contract[39m                                                                                                         [49m
[2C[48;5;237m  [38;5;231m- backend_contract[39m                                                                                                            [49m
[2C[48;5;237m  [38;5;231m- tutor_generator_prompt[39m                                                                                                      [49m
[2C[48;5;237m  [38;5;231m- spec_repair_prompt[39m                                                                                                          [49m
[2C[48;5;237m  [38;5;231m- tutor_analysis_prompt[39m                                                                                                       [49m
[2C[48;5;237m                                                                                                                                [49m
[2C[48;5;237m  [38;5;231mEach document may have linked_documents_json. This should be a JSON object mapping document_type to document_id. For example,[39m [49m
[2C[48;5;237m  [38;5;231m a tutor_prompt document may link to:[39m                                                                                         [49m
[2C[48;5;237m                                                                                                                                [49m
